# Jetson sends MAVLink UDP packets to this laptop on port 14550.
# Use one UDP listener per local port. Add COM9 after the UDP target only if
# you really want automatic USB/serial fallback.
MAVLINK_CONNECTIONS=udpin:0.0.0.0:14550

# Initial time allowed for valid MAVLink traffic to arrive.
# The older MAVLINK_HEARTBEAT_TIMEOUT name is still supported by config.py.
MAVLINK_INITIAL_PACKET_TIMEOUT=10

# false: any valid MAVLink packet can establish the transport connection.
# true: require HEARTBEAT before the connection is accepted.
MAVLINK_REQUIRE_HEARTBEAT=false

# Mark the transport disconnected after no valid MAVLink packets for this long.
TELEMETRY_STALE_AFTER=8

# Report heartbeat as stale after this long, without dropping live telemetry.
MAVLINK_HEARTBEAT_STALE_AFTER=5

# Ask the autopilot for all streams after a heartbeat identifies its system.
# Set to 0 to disable the legacy REQUEST_DATA_STREAM request.
MAVLINK_REQUEST_STREAM_RATE_HZ=20
MAVLINK_RECONNECT_DELAY=3
MAVLINK_SOURCE_SYSTEM=255
MAVLINK_SOURCE_COMPONENT=190

DRONE_ID=Drone-001
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Set a long random value in deployed environments. Empty disables authentication.
DASHBOARD_API_KEY=
BATTERY_CAPACITY_MAH=5000
