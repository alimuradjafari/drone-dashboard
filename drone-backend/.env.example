# Copy this file to .env and replace values for your environment.
DATABASE_URL=postgresql+asyncpg://postgres:alij@localhost:5432/drone_dashboard

# MAVLink inputs, separated by commas when using more than one.
MAVLINK_CONNECTIONS=udpin:0.0.0.0:14550
DRONE_ID=Drone-001

# Allowed dashboard origins.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Optional. When set, protected requests must include this as X-API-Key.
DASHBOARD_API_KEY=
